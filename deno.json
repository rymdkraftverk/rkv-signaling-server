{
  "nodeModulesDir": "none",
  "tasks": {
    "start": "deno run --allow-net --allow-env src/index.ts",
    "dev": "deno run --watch --allow-net --allow-env src/index.ts",
    "test": "deno test --allow-env=GAME_CODE",
    "lint": "deno lint && deno fmt --check",
    "check": "deno check src test",
    "qa": "deno task test && deno task lint && deno task check"
  },
  "imports": {
    "rkv-signaling/": "https://raw.githubusercontent.com/rymdkraftverk/rkv-signaling/21df9b7dc0669bda1c6246d8d655b8509af52df6/src/",
    "protobufjs/light": "npm:protobufjs@^8.8.0/light.js",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing": "jsr:@std/testing@^1"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "include": [
        "no-explicit-any",
        "no-unused-vars",
        "prefer-const",
        "ban-untagged-todo"
      ]
    }
  }
}
