{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "qa": "npm test && npm run lint && npm run typecheck",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.16.4",
    "rkv-signaling": "0.0.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.0",
    "eslint-config-airbnb-extended": "^3.2.0",
    "globals": "^16.5.0",
    "nodemon": "^1.18.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
